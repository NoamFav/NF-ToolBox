# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://license_user:password@localhost:5432/license_db?sslmode=disable

# Auth
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars

# License Signing (ed25519 base64)
# Generate with: go run cmd/keygen/main.go
PRIVATE_KEY=
PUBLIC_KEY=

# Stripe (optional, for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
